# Copiá este archivo como .env (cp .env.example .env) y dejá UNA de las dos MONGODB_URI.
# El nombre de la base va al final de la URL: /album-leyendas

# MongoDB en tu compu (127.0.0.1, no localhost)
MONGODB_URI=mongodb://127.0.0.1:27017/album-leyendas

# MongoDB Atlas (reemplazá usuario, contraseña y cluster por los tuyos)
# MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/album-leyendas

PORT=3000

# La dirección del front: la única web que va a poder pedirle cosas a esta API (CORS).
# En el deploy, acá va la URL de Vercel (sin / al final).
FRONTEND_URL=http://localhost:5173
